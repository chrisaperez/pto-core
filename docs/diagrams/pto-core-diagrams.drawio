<mxCell id="p3-d2" value="&lt;b style=&quot;font-size:16px&quot;&gt;BatchEmitter&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;Fragment = 16 B&lt;br/&gt;4096 per batch = 64 KiB&lt;br/&gt;size histogram here&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pb"><mxGeometry x="444" y="180" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="p3-d3" value="&lt;b style=&quot;font-size:16px&quot;&gt;consumers&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;sizes: histogram&lt;br/&gt;markdup: marker&lt;br/&gt;frip: marker + count&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pb"><mxGeometry x="654" y="180" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="p3-dm" value="&lt;b style=&quot;font-size:16px&quot;&gt;DuplicateMarker&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;sorted: keys (end, strand) of ONE start&lt;br/&gt;hash (--unsorted): 64-bit fingerprints&lt;br/&gt;sets kDuplicate in place&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pb"><mxGeometry x="24" y="310" width="408" height="96" as="geometry"/></mxCell>
<mxCell id="p3-fc" value="&lt;b style=&quot;font-size:16px&quot;&gt;FripCounter.add_batch&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;omp for if batch &amp;gt;= 512; per-thread cursor&lt;br/&gt;5 integer sums; checked_add outside&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pb"><mxGeometry x="448" y="310" width="408" height="96" as="geometry"/></mxCell>
<mxCell id="p3-pb_n" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;exit 2: nothing parsed | out of order (markdup; frip without --keep-dups) | no overlap and bad naming&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontColor=#37474F;" vertex="1" parent="p3-pb"><mxGeometry x="24" y="414" width="832" height="20" as="geometry"/></mxCell>
<mxCell id="p3-f0" value="&lt;b style=&quot;font-size:16px&quot;&gt;guards&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;output != input&lt;br/&gt;limits checked&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="24" y="64" width="150" height="100" as="geometry"/></mxCell>
<mxCell id="p3-f1" value="&lt;b style=&quot;font-size:16px&quot;&gt;regions&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;BED/GTF (.gz)&lt;br/&gt;names sanitised&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="194" y="64" width="150" height="100" as="geometry"/></mxCell>
<mxCell id="p3-f2" value="&lt;b style=&quot;font-size:16px&quot;&gt;BamReader&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;header, index;&lt;br/&gt;mapped total from&lt;br/&gt;index metadata&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="364" y="64" width="150" height="100" as="geometry"/></mxCell>
<mxCell id="p3-f3" value="&lt;b style=&quot;font-size:16px&quot;&gt;compute&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;compute_matrix:&lt;br/&gt;N&amp;lt;=256, N&amp;lt;=rows;&lt;br/&gt;row blocks&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="534" y="64" width="150" height="100" as="geometry"/></mxCell>
<mxCell id="p3-f4" value="&lt;b style=&quot;font-size:16px&quot;&gt;finish&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;scale, means,&lt;br/&gt;write TSV;&lt;br/&gt;all skipped: rc 2&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="704" y="64" width="150" height="100" as="geometry"/></mxCell>
<mxCell id="p3-g0" value="&lt;b style=&quot;font-size:16px&quot;&gt;window&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;TSS/center/TES&lt;br/&gt;anchor; minus&lt;br/&gt;strand mirrored&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="24" y="220" width="150" height="110" as="geometry"/></mxCell>
<mxCell id="p3-g1" value="&lt;b style=&quot;font-size:16px&quot;&gt;skip?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;no such contig,&lt;br/&gt;or off the contig:&lt;br/&gt;row = missing&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="194" y="220" width="150" height="110" as="geometry"/></mxCell>
<mxCell id="p3-g2" value="&lt;b style=&quot;font-size:16px&quot;&gt;query_bins&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;widen by max fragment;&lt;br/&gt;sam_itr_queryi&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="364" y="220" width="150" height="110" as="geometry"/></mxCell>
<mxCell id="p3-g3" value="&lt;b style=&quot;font-size:16px&quot;&gt;alignment&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;flags + MAPQ;&lt;br/&gt;leftmost mate:&lt;br/&gt;TLEN span;&lt;br/&gt;reads + bases&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="534" y="220" width="150" height="110" as="geometry"/></mxCell>
<mxCell id="p3-g4" value="&lt;b style=&quot;font-size:16px&quot;&gt;row&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;fill bins;&lt;br/&gt;minus strand reversed:&lt;br/&gt;5&amp;#x27; to 3&amp;#x27;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pc"><mxGeometry x="704" y="220" width="150" height="110" as="geometry"/></mxCell>
<mxCell id="p3-pc_n" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;matrix = regions x bins doubles, allocated up front (bins &amp;lt;= 10,000,000)&lt;br/&gt;means: min(N, rows/64, 64 MiB/(cols*8)) reducers, cache-line aligned&lt;br/&gt;skipped rows stay in the matrix but leave means, BPM total and scaling&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontColor=#37474F;" vertex="1" parent="p3-pc"><mxGeometry x="24" y="354" width="832" height="60" as="geometry"/></mxCell>
<mxCell id="p3-h0" value="&lt;b style=&quot;font-size:16px&quot;&gt;detect&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;peek first byte:&lt;br/&gt;1f = BAM, else BED&lt;br/&gt;(stdin ok)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pd"><mxGeometry x="24" y="64" width="190" height="100" as="geometry"/></mxCell>
<mxCell id="p3-h1" value="&lt;b style=&quot;font-size:16px&quot;&gt;records&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;BAM: BGZF + CRC32,&lt;br/&gt;leftmost mate TLEN&amp;gt;0&lt;br/&gt;BED: 4 MiB blocks&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pd"><mxGeometry x="234" y="64" width="190" height="100" as="geometry"/></mxCell>
<mxCell id="p3-h2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Driver.add&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;order and bounds&lt;br/&gt;checked; seek across&lt;br/&gt;coverage deserts&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pd"><mxGeometry x="444" y="64" width="190" height="100" as="geometry"/></mxCell>
<mxCell id="p3-h3" value="&lt;b style=&quot;font-size:16px&quot;&gt;finalize&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;BH over ALL&lt;br/&gt;candidates, then&lt;br/&gt;narrowPeak&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pd"><mxGeometry x="654" y="64" width="190" height="100" as="geometry"/></mxCell>
<mxCell id="p3-i0" value="&lt;b style=&quot;font-size:16px&quot;&gt;MultiScaleWindow&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;delta + pileup rings,&lt;br/&gt;2 x 16384 x int64&lt;br/&gt;= 256 KiB&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pd"><mxGeometry x="24" y="220" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="p3-i1" value="&lt;b style=&quot;font-size:16px&quot;&gt;3 backgrounds&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;centred 1k, 5k, 10k&lt;br/&gt;running sums;&lt;br/&gt;lag = 5000 bases&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pd"><mxGeometry x="234" y="220" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="p3-i2" value="&lt;b style=&quot;font-size:16px&quot;&gt;PeakCaller&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;prefilter, queue of 256,&lt;br/&gt;SIMD Poisson -log10 p&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pd"><mxGeometry x="444" y="220" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="p3-i3" value="&lt;b style=&quot;font-size:16px&quot;&gt;state machine&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;IDLE, IN_PEAK,&lt;br/&gt;SUMMIT_SEARCH,&lt;br/&gt;CLOSING (max_gap)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p3-pd"><mxGeometry x="654" y="220" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="p3-pd_n" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;lambda = max(genome floor, 3 local rates); a degenerate lambda scores p = 1 (fails closed)&lt;br/&gt;peaks are held (32 B each) until finalize(): BH needs every p-value, so only the INPUT streams&lt;br/&gt;exit 2: unsorted, contig not in sizes, bad field, BED fragment &amp;gt; 4096 bp (BAM: counted skipped)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontColor=#37474F;" vertex="1" parent="p3-pd"><mxGeometry x="24" y="354" width="832" height="60" as="geometry"/></mxCell>
