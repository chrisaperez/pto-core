<mxCell id="p1-title" value="&lt;b&gt;Five independent C++20 engines behind one process boundary&lt;/b&gt;" style="text;html=1;fontSize=32;fontFamily=Inter;fontColor=#0F2A43;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="64" y="28" width="1792" height="44" as="geometry"/></mxCell>
<mxCell id="p1-subtitle" value="No shared runtime and no shared code: callers reach an engine only through argv, files, stdio and an exit code." style="text;html=1;fontSize=17;fontFamily=Inter;fontColor=#546E7A;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="64" y="76" width="1792" height="28" as="geometry"/></mxCell>
<mxCell id="p1-footer" value="Sources: packaging/pto/*, pyproject.toml, CMakeLists.txt, modules/*/src/main.cpp (commit 0ba20d1)" style="text;html=1;fontSize=11;fontFamily=Inter;fontColor=#78909C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="64" y="1050" width="1792" height="22" as="geometry"/></mxCell>
<mxCell id="p1-z_call" value="&lt;b style=&quot;font-size:16px&quot;&gt;CALLERS&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#37474F;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="124" width="1792" height="140" as="geometry"/></mxCell>
<mxCell id="p1-z_py" value="&lt;b style=&quot;font-size:16px&quot;&gt;PYTHON ORCHESTRATION   packaging/pto   stdlib only, zero runtime dependencies&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B4D20;fillColor=#F4FAF5;strokeColor=#2E7D32;strokeWidth=1.5;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="292" width="912" height="270" as="geometry"/></mxCell>
<mxCell id="p1-band" value="&lt;b style=&quot;font-size:16px&quot;&gt;PROCESS BOUNDARY   argv + files + stdio + exit code   no shared memory   no IPC&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#3F2266;fillColor=#EFE6FA;strokeColor=#6A3FA0;strokeWidth=1.5;rounded=1;arcSize=12;align=center;verticalAlign=middle;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="64" y="590" width="1792" height="48" as="geometry"/></mxCell>
<mxCell id="p1-z_eng" value="&lt;b style=&quot;font-size:16px&quot;&gt;C++20 ENGINES&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#F5F9FF;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="666" width="1792" height="250" as="geometry"/></mxCell>
<mxCell id="p1-l_fq" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;zlib + libdeflate&lt;br/&gt;htslib optional (ON in the wheel)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#424242;fillColor=#F4F4F4;strokeColor=#757575;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="88" y="928" width="328" height="56" as="geometry"/></mxCell>
<mxCell id="p1-l_gtk" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;htslib (AUTO-detected)&lt;br/&gt;OpenMP optional&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#424242;fillColor=#F4F4F4;strokeColor=#757575;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="440" y="928" width="328" height="56" as="geometry"/></mxCell>
<mxCell id="p1-l_pk" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;libdeflate or zlib (BAM/BGZF)&lt;br/&gt;no htslib&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#424242;fillColor=#F4F4F4;strokeColor=#757575;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="792" y="928" width="328" height="56" as="geometry"/></mxCell>
<mxCell id="p1-l_cp" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;htslib (required)&lt;br/&gt;httplib + json (server only)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#424242;fillColor=#F4F4F4;strokeColor=#757575;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1144" y="928" width="328" height="56" as="geometry"/></mxCell>
<mxCell id="p1-l_sc" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;OpenMP (required, hard fail)&lt;br/&gt;hnswlib (vendored, patched)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#424242;fillColor=#F4F4F4;strokeColor=#757575;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1496" y="928" width="328" height="56" as="geometry"/></mxCell>
<mxCell id="p1-build" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;cmake -S . : PTO_BUILD_* x5 (PTO_CLOUD_BUILD off)  -&amp;gt;  wheel pto-core py3-none-&amp;lt;platform&amp;gt;, 4 CLIs in pto/_vendor/bin  |  wheel scrna-matrix cp39-cp313  |  four private copies of file_identity.hpp&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#3F2266;fillColor=#EFE6FA;strokeColor=#6A3FA0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="64" y="996" width="1792" height="44" as="geometry"/></mxCell>
