<mxCell id="p4-title" value="&lt;b&gt;Everything outside the engines meets them at one contract&lt;/b&gt;" style="text;html=1;fontSize=32;fontFamily=Inter;fontColor=#0F2A43;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="64" y="28" width="1792" height="44" as="geometry"/></mxCell>
<mxCell id="p4-subtitle" value="argv in; JSON, files and an exit code out. The wrapper adds resolution, thread budgeting and error typing." style="text;html=1;fontSize=17;fontFamily=Inter;fontColor=#546E7A;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="64" y="76" width="1792" height="28" as="geometry"/></mxCell>
