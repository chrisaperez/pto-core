<mxCell id="p1-c_scp" value="&lt;b style=&quot;font-size:16px&quot;&gt;scanpy / AnnData&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;import scrna_matrix&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#424242;fillColor=#F4F4F4;strokeColor=#757575;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;dashed=1;dashPattern=8 4;" vertex="1" parent="p1-z_call"><mxGeometry x="1572" y="40" width="196" height="88" as="geometry"/></mxCell>
<mxCell id="p1-py_cli" value="&lt;b style=&quot;font-size:16px&quot;&gt;cli.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;argparse, 12 subcommands&lt;br/&gt;exec uses os.execv&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B4D20;fillColor=#E6F4EA;strokeColor=#2E7D32;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_py"><mxGeometry x="24" y="52" width="272" height="96" as="geometry"/></mxCell>
<mxCell id="p1-py_api" value="&lt;b style=&quot;font-size:16px&quot;&gt;api.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;7 functions&lt;br/&gt;None kwargs are omitted&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B4D20;fillColor=#E6F4EA;strokeColor=#2E7D32;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_py"><mxGeometry x="320" y="52" width="272" height="96" as="geometry"/></mxCell>
<mxCell id="p1-py_cpu" value="&lt;b style=&quot;font-size:16px&quot;&gt;_cpu.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;min(affinity, cgroup quota,&lt;br/&gt;cpu_count), never below 1&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B4D20;fillColor=#E6F4EA;strokeColor=#2E7D32;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_py"><mxGeometry x="616" y="52" width="272" height="96" as="geometry"/></mxCell>
<mxCell id="p1-py_bin" value="&lt;b style=&quot;font-size:16px&quot;&gt;_binaries.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;$PTO_BIN_DIR &amp;gt; pto/_vendor/bin&lt;br/&gt;&amp;gt; $PATH&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B4D20;fillColor=#E6F4EA;strokeColor=#2E7D32;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_py"><mxGeometry x="24" y="160" width="272" height="96" as="geometry"/></mxCell>
<mxCell id="p1-py_run" value="&lt;b style=&quot;font-size:16px&quot;&gt;_run.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;Popen, shell=False&lt;br/&gt;os.wait4: wall time + peak RSS&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B4D20;fillColor=#E6F4EA;strokeColor=#2E7D32;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_py"><mxGeometry x="320" y="160" width="272" height="96" as="geometry"/></mxCell>
<mxCell id="p1-py_err" value="&lt;b style=&quot;font-size:16px&quot;&gt;errors.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;rc 2 = InvalidInput&lt;br/&gt;other rc = ToolError&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B4D20;fillColor=#E6F4EA;strokeColor=#2E7D32;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_py"><mxGeometry x="616" y="160" width="272" height="96" as="geometry"/></mxCell>
<mxCell id="p1-e_fq" value="&lt;b style=&quot;font-size:16px&quot;&gt;fastq_stream 0.1.0&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;CLI: streaming QC and trimming&lt;br/&gt;in: FASTQ raw/gz/BGZF; BAM/CRAM/SAM&lt;br/&gt;out: QC JSON + text; FASTQ to file/FIFO/stdout&lt;br/&gt;threads 3+D+W; SIMD runtime&lt;br/&gt;exit 0 | 1 | 2 (usage errors too)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_eng"><mxGeometry x="24" y="46" width="328" height="190" as="geometry"/></mxCell>
<mxCell id="p1-e_gtk" value="&lt;b style=&quot;font-size:16px&quot;&gt;genomic_toolkit 0.1.0&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;CLI: sizes | markdup | frip&lt;br/&gt;in: BAM/CRAM, BEDPE, fragment BED&lt;br/&gt;out: JSON on stdout (+ histogram TSV)&lt;br/&gt;threads 1 + OpenMP (FRiP); no hand SIMD&lt;br/&gt;exit 0 | 1 | 2&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_eng"><mxGeometry x="376" y="46" width="328" height="190" as="geometry"/></mxCell>
<mxCell id="p1-e_pk" value="&lt;b style=&quot;font-size:16px&quot;&gt;pto-peaks 0.1.0&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;CLI: streaming peak caller&lt;br/&gt;in: fragment BED or sorted BAM (stdin ok)&lt;br/&gt;out: narrowPeak; BAM decoded natively&lt;br/&gt;threads 1; SIMD runtime (Poisson)&lt;br/&gt;exit 0 | 1 | 2&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_eng"><mxGeometry x="728" y="46" width="328" height="190" as="geometry"/></mxCell>
<mxCell id="p1-e_cp" value="&lt;b style=&quot;font-size:16px&quot;&gt;cuttag_profiler 1.0.0&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;CLI: profile | serve&lt;br/&gt;in: indexed BAM + BED/GTF&lt;br/&gt;out: matrix.tsv + profile.tsv, or HTTP&lt;br/&gt;threads N workers; no hand SIMD&lt;br/&gt;exit 0 | 1 | 2&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_eng"><mxGeometry x="1080" y="46" width="328" height="190" as="geometry"/></mxCell>
<mxCell id="p1-e_sc" value="&lt;b style=&quot;font-size:16px&quot;&gt;scrna_matrix&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;header-only C++20 + pybind11 module&lt;br/&gt;in: NumPy/SciPy CSR buffers&lt;br/&gt;out: KnnGraph as NumPy views&lt;br/&gt;threads OpenMP; SIMD runtime&lt;br/&gt;no CLI, no exit code; own wheel&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p1-z_eng"><mxGeometry x="1432" y="46" width="328" height="190" as="geometry"/></mxCell>
