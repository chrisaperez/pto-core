<diagram id="p2" name="2 Streaming">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p2-title" value="&lt;b&gt;fastq_stream moves buffer handles, not bytes&lt;/b&gt;" style="text;html=1;fontSize=32;fontFamily=Inter;fontColor=#0F2A43;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="64" y="28" width="1792" height="44" as="geometry"/></mxCell>
<mxCell id="p2-subtitle" value="3 + D + W threads joined by lock-free SPSC rings; a 256 KiB payload is copied at four points only." style="text;html=1;fontSize=17;fontFamily=Inter;fontColor=#546E7A;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="64" y="76" width="1792" height="28" as="geometry"/></mxCell>
<mxCell id="p2-footer" value="Sources: fastq_stream/src/pipeline.cpp:263-613, reader.cpp:32-380, buffer.hpp, lockfree_queue.hpp (commit 0ba20d1); thread math checked at 14 configurations" style="text;html=1;fontSize=11;fontFamily=Inter;fontColor=#78909C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="64" y="1050" width="1792" height="22" as="geometry"/></mxCell>
<mxCell id="p2-src" value="&lt;b style=&quot;font-size:16px&quot;&gt;SOURCE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;path | - | FIFO&lt;br/&gt;BAM/CRAM/SAM by content&lt;br/&gt;(regular files only)&lt;br/&gt;framing: 1f 8b + BC = BGZF&lt;br/&gt;1f 8b alone = gzip; else raw&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#6B4A0E;fillColor=#FFF4DB;strokeColor=#B7791F;strokeWidth=1.5;shape=document;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="64" y="136" width="232" height="200" as="geometry"/></mxCell>
<mxCell id="p2-read" value="&lt;b style=&quot;font-size:16px&quot;&gt;READER  1 thread&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;FdSource 1 MiB stage + fadvise&lt;br/&gt;BGZF: &amp;lt;= 4 whole members per Buffer (c1)&lt;br/&gt;gzip: zlib inflate into the Buffer&lt;br/&gt;raw: memcpy stage -&amp;gt; Buffer (c1)&lt;br/&gt;BAM: htslib decode pool, FASTQ text&lt;br/&gt;EOF: BGZF must end in its 28 B block&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="336" y="136" width="360" height="200" as="geometry"/></mxCell>
<mxCell id="p2-ringA" value="&lt;b style=&quot;font-size:16px&quot;&gt;lane x D&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;SpscRing&amp;lt;Buffer,16&amp;gt;&lt;br/&gt;15 usable slots&lt;br/&gt;closed flag&lt;br/&gt;BGZF only&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="736" y="136" width="200" height="200" as="geometry"/></mxCell>
<mxCell id="p2-infl" value="&lt;b style=&quot;font-size:16px&quot;&gt;INFLATERS  D threads&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;libdeflate, 1 decompressor each&lt;br/&gt;4 members -&amp;gt; one 256 KiB Buffer&lt;br/&gt;compressed Buffer -&amp;gt; in_pool&lt;br/&gt;D = max(1, spare/3)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="976" y="136" width="320" height="200" as="geometry"/></mxCell>
<mxCell id="p2-ringB" value="&lt;b style=&quot;font-size:16px&quot;&gt;lane x D&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;pop order = push order&lt;br/&gt;chunk k on lane k mod D&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1336" y="136" width="200" height="200" as="geometry"/></mxCell>
<mxCell id="p2-asm" value="&lt;b style=&quot;font-size:16px&quot;&gt;ASSEMBLER  1 thread&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;pop lane[k mod D] or the direct lane&lt;br/&gt;carry spliced into 64 KiB prefix (c2)&lt;br/&gt;cut at the 4th newline (memchr)&lt;br/&gt;whole records -&amp;gt; lane j mod W&lt;br/&gt;partial tail -&amp;gt; carry (max 64 KiB)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1526" y="400" width="330" height="200" as="geometry"/></mxCell>
<mxCell id="p2-ringC" value="&lt;b style=&quot;font-size:16px&quot;&gt;lane x W&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;input of worker i&lt;br/&gt;chunk j on lane j mod W&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1290" y="400" width="200" height="200" as="geometry"/></mxCell>
<mxCell id="p2-work" value="&lt;b style=&quot;font-size:16px&quot;&gt;WORKERS  W threads&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;out Buffer from out_pool (320 KiB)&lt;br/&gt;checks -&amp;gt; Phred+64 rebase -&amp;gt; QC on RAW&lt;br/&gt;trim -&amp;gt; adapters -&amp;gt; filters&lt;br/&gt;survivors memcpy&amp;#x27;d into out (c3)&lt;br/&gt;SIMD: runtime ISA kernels&lt;br/&gt;always ONE out Buffer per chunk&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="890" y="400" width="360" height="200" as="geometry"/></mxCell>
<mxCell id="p2-ringD" value="&lt;b style=&quot;font-size:16px&quot;&gt;lane x W&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;output of worker i&lt;br/&gt;one Buffer per input chunk&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="200" height="200" as="geometry"/></mxCell>
<mxCell id="p2-writ" value="&lt;b style=&quot;font-size:16px&quot;&gt;WRITER  1 thread&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;pop lane k mod W in order&lt;br/&gt;write(2), EINTR retried (c4)&lt;br/&gt;SIGPIPE ignored; close checked&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0D3B72;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="364" y="400" width="250" height="200" as="geometry"/></mxCell>
<mxCell id="p2-sink" value="&lt;b style=&quot;font-size:16px&quot;&gt;SINK&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;stdout | file | FIFO&lt;br/&gt;--mkfifo: open blocks&lt;br/&gt;until a reader attaches&lt;br/&gt;refused: -i X -o X&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#6B4A0E;fillColor=#FFF4DB;strokeColor=#B7791F;strokeWidth=1.5;shape=document;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="64" y="400" width="260" height="200" as="geometry"/></mxCell>
<mxCell id="p2-p_buf" value="&lt;b style=&quot;font-size:16px&quot;&gt;BUFFER ANATOMY   buffer.hpp:28-35&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#37474F;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="632" width="880" height="184" as="geometry"/></mxCell>
<mxCell id="p2-p_ring" value="&lt;b style=&quot;font-size:16px&quot;&gt;SPSC RING   lockfree_queue.hpp:47&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#37474F;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="976" y="632" width="880" height="184" as="geometry"/></mxCell>
<mxCell id="p2-p_copy" value="&lt;b style=&quot;font-size:16px&quot;&gt;THE FOUR COPY POINTS&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#37474F;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="832" width="880" height="184" as="geometry"/></mxCell>
<mxCell id="p2-p_ctl" value="&lt;b style=&quot;font-size:16px&quot;&gt;CONTROL AND BOUNDS&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#37474F;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="976" y="832" width="880" height="184" as="geometry"/></mxCell>
<mxCell id="p2-b_pre" value="&lt;b style=&quot;font-size:16px&quot;&gt;kPrefix 64 KiB&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;headroom in front of data()&lt;br/&gt;extend_front() splices the carry&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#6B4A0E;fillColor=#FFF4DB;strokeColor=#B7791F;strokeWidth=1.5;shape=document;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_buf"><mxGeometry x="24" y="44" width="280" height="96" as="geometry"/></mxCell>
<mxCell id="p2-b_pay" value="&lt;b style=&quot;font-size:16px&quot;&gt;payload 256 KiB (in_pool)   320 KiB (out_pool)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;data() ... size() ... capacity()&lt;br/&gt;64 B aligned by aligned_alloc&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#6B4A0E;fillColor=#FFF4DB;strokeColor=#B7791F;strokeWidth=1.5;shape=document;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_buf"><mxGeometry x="304" y="44" width="552" height="96" as="geometry"/></mxCell>
<mxCell id="p2-b_note" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;handle = {pool*, base*, cap, size, front_} + seq (written, never read); free list under std::mutex&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontColor=#37474F;" vertex="1" parent="p2-p_buf"><mxGeometry x="24" y="148" width="832" height="28" as="geometry"/></mxCell>
<mxCell id="p2-r0" value="&lt;b style=&quot;font-size:16px&quot;&gt;head_&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;consumer&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_ring"><mxGeometry x="24" y="44" width="160" height="96" as="geometry"/></mxCell>
<mxCell id="p2-r1" value="&lt;b style=&quot;font-size:16px&quot;&gt;cached_tail_&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;consumer-private&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_ring"><mxGeometry x="196" y="44" width="160" height="96" as="geometry"/></mxCell>
<mxCell id="p2-r2" value="&lt;b style=&quot;font-size:16px&quot;&gt;tail_&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;producer&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_ring"><mxGeometry x="368" y="44" width="160" height="96" as="geometry"/></mxCell>
<mxCell id="p2-r3" value="&lt;b style=&quot;font-size:16px&quot;&gt;cached_head_&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;producer-private&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_ring"><mxGeometry x="540" y="44" width="160" height="96" as="geometry"/></mxCell>
<mxCell id="p2-r4" value="&lt;b style=&quot;font-size:16px&quot;&gt;slots_[16]&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;Buffer handles&lt;br/&gt;15 usable&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_ring"><mxGeometry x="712" y="44" width="160" height="96" as="geometry"/></mxCell>
<mxCell id="p2-r_note" value="&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;each member alignas(128), so producer and consumer share no line; kCacheLine = 128 B on arm64 and x86-64&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontColor=#37474F;" vertex="1" parent="p2-p_ring"><mxGeometry x="24" y="148" width="832" height="28" as="geometry"/></mxCell>
<mxCell id="p2-c1" value="&lt;b style=&quot;font-size:16px&quot;&gt;(c1) stage -&amp;gt; Buffer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;raw and BGZF compressed batch; gzip inflates in place&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#5B4300;fillColor=#FFFBEA;strokeColor=#E0B84C;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_copy"><mxGeometry x="24" y="44" width="196" height="124" as="geometry"/></mxCell>
<mxCell id="p2-c2" value="&lt;b style=&quot;font-size:16px&quot;&gt;(c2) carry splice&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;only the straddling partial record, at most 64 KiB&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#5B4300;fillColor=#FFFBEA;strokeColor=#E0B84C;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_copy"><mxGeometry x="236" y="44" width="196" height="124" as="geometry"/></mxCell>
<mxCell id="p2-c3" value="&lt;b style=&quot;font-size:16px&quot;&gt;(c3) serialise&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;worker writes surviving records into the out Buffer&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#5B4300;fillColor=#FFFBEA;strokeColor=#E0B84C;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_copy"><mxGeometry x="448" y="44" width="196" height="124" as="geometry"/></mxCell>
<mxCell id="p2-c4" value="&lt;b style=&quot;font-size:16px&quot;&gt;(c4) write(2)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;the kernel&amp;#x27;s copy to file, FIFO or stdout&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#5B4300;fillColor=#FFFBEA;strokeColor=#E0B84C;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_copy"><mxGeometry x="660" y="44" width="196" height="124" as="geometry"/></mxCell>
<mxCell id="p2-k_gate" value="&lt;b style=&quot;font-size:16px&quot;&gt;ErrorGate&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;first error wins&lt;br/&gt;abort flag polled in every ring wait&lt;br/&gt;then join, then throw&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_ctl"><mxGeometry x="24" y="44" width="272" height="124" as="geometry"/></mxCell>
<mxCell id="p2-k_term" value="&lt;b style=&quot;font-size:16px&quot;&gt;Termination&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;producer release-stores closed&lt;br/&gt;consumer exits on empty AND closed&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#004D40;fillColor=#DDF5F1;strokeColor=#00796B;strokeWidth=1.5;shape=process;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_ctl"><mxGeometry x="308" y="44" width="272" height="124" as="geometry"/></mxCell>
<mxCell id="p2-k_mem" value="&lt;b style=&quot;font-size:16px&quot;&gt;Memory bound&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;(lanes x 15 + in-flight) x &amp;lt;= 384 KiB&lt;br/&gt;measured 47 blocks = 15.8 MB, 12.8 MB FASTQ, -t 6&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#6B4A0E;fillColor=#FFF4DB;strokeColor=#B7791F;strokeWidth=1.5;shape=document;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="p2-p_ctl"><mxGeometry x="592" y="44" width="272" height="124" as="geometry"/></mxCell>
