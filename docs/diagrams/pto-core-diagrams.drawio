<mxCell id="p1-c_path" value="&lt;b style=&quot;font-size:16px&quot;&gt;shell / SLURM&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;font-family:Inter, Helvetica, Arial, sans-serif&quot;&gt;bare tool names on PATH&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#424242;fillColor=#F4F4F4;strokeColor=#757575;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;dashed=1;dashPattern=8 4;" vertex="1" parent="p1-z_call"><mxGeometry x="936" y="40" width="196" height="88" as="geometry"/></mxCell>
